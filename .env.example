# .env.example
# DiscoverLatest 2.0 環境變數範本
# 禁止將實際值填入此檔案或 commit 到 repo

# ── Gemini（僅用於 Batch Search Grounding）────────────────
# 每天只有 20 次文字 RPD（grounding 呼叫共用此配額）
# 多把 key 用逗號分隔，每把 key 各自計算配額
GEMINI_API_KEY=your_google_ai_studio_key
# GEMINI_API_KEYS=key1,key2,key3   # 多把 key 寫法

# ── NVIDIA NIM（主要分析引擎）────────────────────────────
# 模型：moonshotai/kimi-k2.5，40 RPM，無日限制
# 取得：https://build.nvidia.com/settings/api-key
NVIDIA_API_KEY=nvapi-xxxx

# ── Supabase ─────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...

# ── Pinecone（知識庫 RAG）────────────────────────────────
PINECONE_API_KEY=your_key
PINECONE_INDEX_NAME=discoverlatest-knowledge

# ── HuggingFace（冷層封存）──────────────────────────────
HF_TOKEN=hf_xxx
HF_DATASET_REPO=your_username/discoverlatest-archive

# ── FinMind（台股資料，多 Token 逗號分隔）────────────────
# FINMIND_TOKENS=token1,token2   # 多 Token 寫法
FINMIND_TOKEN=your_finmind_token

# ── Gmail SMTP ───────────────────────────────────────────
GMAIL_SMTP_USER=your_email@gmail.com
GMAIL_SMTP_APP_PASSWORD=your_app_password

# ── Google OAuth ─────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id

# ── 應用設定 ──────────────────────────────────────────────
APP_ENV=production
SECRET_KEY=32字元隨機字串
DAILY_GROUNDING_RPD_BUDGET=18  # Gemini grounding 每日上限（實際 RPD=20，留 buffer）
SUPABASE_WARN_MB=350
SUPABASE_CRITICAL_MB=425
SPACE_URL=https://alanalways-discover-latest-v2.hf.space
