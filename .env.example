# .env.example
# DiscoverLatest 2.0 環境變數範本
# 禁止將實際值填入此檔案或 commit 到 repo

# ── Gemini（Runtime AI 大腦）──────────────────────────────
GEMINI_API_KEY=your_google_ai_studio_key

# ── Supabase ─────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...

# ── Pinecone（知識庫 RAG）────────────────────────────────
PINECONE_API_KEY=your_key
PINECONE_INDEX_NAME=discoverlatest-knowledge

# ── HuggingFace（冷層封存）──────────────────────────────
HF_TOKEN=hf_xxx
HF_DATASET_REPO=your_username/discoverlatest-archive

# ── 應用設定 ──────────────────────────────────────────────
APP_ENV=production
SECRET_KEY=32字元隨機字串
DAILY_GEMINI_RPD_BUDGET=800
SUPABASE_WARN_MB=350
SUPABASE_CRITICAL_MB=425
